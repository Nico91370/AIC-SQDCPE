# Base PostgreSQL
DATABASE_URL=postgres://sqdcpe:sqdcpe@localhost:5432/sqdcpe
# DATABASE_SSL=true            # pour Azure Database for PostgreSQL

PORT=3000

# Authentification : "dev" (nom saisi, pour tester) ou "entra" (Microsoft 365)
AUTH_MODE=dev
# Code d'accès demandé en mode test (conseillé dès que le site est accessible en ligne)
# ACCESS_CODE=choisissez-un-code
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Adresses toujours administratrices (séparées par des virgules)
# ADMIN_EMAILS=prenom.nom@entreprise.fr
# Rôle donné aux nouveaux utilisateurs : animateur ou lecteur
DEFAULT_ROLE=animateur
